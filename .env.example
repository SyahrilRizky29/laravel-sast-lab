APP_NAME="Laravel SAST Lab"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=true
# ⚠️  VULNERABILITY: APP_DEBUG=true di production mengekspos stack trace dan env vars ke user!
# Seharusnya: APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# ⚠️  VULNERABILITY: LOG_LEVEL=debug mencatat terlalu banyak informasi sensitif
# Seharusnya di production: LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_sast_lab
DB_USERNAME=root
DB_PASSWORD=password123
# ⚠️  VULNERABILITY: Password database lemah dan tersimpan di file yang mungkin di-commit!
# .env TIDAK boleh di-commit ke repository! Pastikan ada di .gitignore

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
# ⚠️  VULNERABILITY: SESSION_DRIVER=cookie menyimpan data session di browser (tidak terenkripsi dengan baik)
# Seharusnya: SESSION_DRIVER=database atau redis

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# API Keys — JANGAN simpan di sini!
# ⚠️  VULNERABILITY: API key disimpan di .env yang mungkin ter-expose
PAYMENT_GATEWAY_KEY=pg_live_key_abc123xyz
PAYMENT_GATEWAY_SECRET=pg_secret_live_abc123xyz456
MIDTRANS_SERVER_KEY=Mid-server-XXXX-LIVE-KEY
MIDTRANS_CLIENT_KEY=Mid-client-XXXX-LIVE-KEY
THIRD_PARTY_API_KEY=sk-prod-abc123xyz789secretkey
